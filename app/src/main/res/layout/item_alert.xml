<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_alert_card"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp">

    <!--  Severity color stripe, tinted at runtime  -->
    <View
        android:id="@+id/severityStripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/color_warning" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/severityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textStyle="bold"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                tools:text="CRITICAL" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_muted"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="14:32:01" />
        </LinearLayout>

        <TextView
            android:id="@+id/macIpLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingTop="8dp"
            tools:text="DE:AD:BE:EF:13:37 → 192.168.1.10" />

        <TextView
            android:id="@+id/explanationLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            android:paddingTop="4dp"
            tools:text="IP address claimed by multiple MAC addresses" />
    </LinearLayout>
</LinearLayout>